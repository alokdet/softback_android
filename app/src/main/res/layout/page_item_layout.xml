<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/task_preview_background"
    android:backgroundTint="?attr/foreground_color"
    android:id="@+id/container_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/designName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24 December 2024"
            android:textSize="17sp"
            android:textColor="?attr/title_text_color"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="17dp"
            android:ellipsize="end"
            android:singleLine="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/designVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="lorem"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="2dp"
            android:layout_marginEnd="20dp"
            android:maxLines="5"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintTop_toBottomOf="@id/designName"
            app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>