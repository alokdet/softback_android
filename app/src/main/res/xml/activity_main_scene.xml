<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        app:constraintSetEnd="@id/collapsed"
        app:constraintSetStart="@id/expanded"
        app:duration="1000">

        <KeyFrameSet></KeyFrameSet>

        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@id/recyclerView"
            app:touchAnchorSide="top" />

    </Transition>

    <ConstraintSet android:id="@+id/expanded">

        <Constraint android:id="@id/greet_user_view">

            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="60dp"
                android:fontFamily="@font/roboto_light"
                android:text="Welcome Alok"
                android:textAlignment="center"
                android:textColor="?attr/title_text_color"
                android:textSize="22sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </Constraint>

        <Constraint android:id="@id/heading_view">

            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="60dp"
                android:fontFamily="@font/akshar_regular"
                android:lineHeight="36dp"
                android:text="TRY THE ALL NEW GRAND THEFT AUTO STYLE WALLPAPERS"
                android:textAlignment="center"
                android:textColor="?attr/sub_text_color"
                android:textSize="36sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/greet_user_view" />
        </Constraint>

        <Constraint android:id="@id/image_s">

            <Layout
                android:layout_width="0dp"
                android:layout_height="360dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heading_view" />
        </Constraint>

        <Constraint android:id="@id/action_btn">

            <Layout
                android:layout_width="100dp"
                android:layout_height="60dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/image_s" />
        </Constraint>

        <Constraint android:id="@+id/recyclerView">

            <Layout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/action_btn" />
        </Constraint>

    </ConstraintSet>

    <ConstraintSet android:id="@+id/collapsed">

        <Constraint android:id="@id/greet_user_view">

            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />
            <Transform
                android:alpha="0"
                android:scaleX="0.65"
                android:scaleY="0.65"
                android:translationY="-15dp" />
        </Constraint>

        <Constraint android:id="@id/heading_view">

            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/greet_user_view" />
            <Transform
                android:alpha="0"
                android:scaleX="0.65"
                android:scaleY="0.65"
                android:translationY="-15dp" />

        </Constraint>

        <Constraint android:id="@id/image_s">

            <Layout
                android:layout_width="0dp"
                android:layout_height="360dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heading_view" />

            <Transform
                android:alpha="0"
                android:scaleX="0.65"
                android:scaleY="0.65"
                android:translationY="-150dp" />
        </Constraint>

        <Constraint android:id="@id/action_btn">

            <Layout
                android:layout_width="100dp"
                android:layout_height="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </Constraint>

        <Constraint android:id="@+id/recyclerView">

            <Layout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/action_btn" />
        </Constraint>

    </ConstraintSet>

</MotionScene>